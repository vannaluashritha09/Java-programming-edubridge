public class Point {
        int x;
        int y;

        // Constructor
        Point(int x, int y) {
            this.x = x;
            this.y = y;
        }

        // Method to display point
        void display() {
            System.out.println("Point = (" + x + ", " + y + ")");
        }

        public static void main(String[] args) {
            // Creating objects
            Point p1 = new Point(10, 20);
            Point p2 = new Point(5, 8);

            // Display points
            p1.display();
            p2.display();
        }
}
